# Coverage profiles are build output.
*.out
coverage

# Binaries produced by `go build` without -o.
/foundation-reference
/foundation-reference-migrate

# Local development environment. .env.example is committed; the real one is not.
.env
.fmt.tmp

# The system proof's working area: CI checks organization-control out here at the pinned revision,
# and the proof refuses to run against a dirty tree -- so an untracked checkout inside this one would
# make every CI run refuse itself.
.systemproof/

# Editor and OS noise.
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

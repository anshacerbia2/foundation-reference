# NOTE: every credential below is a placeholder. Put your own values in .env, which is
# gitignored -- never here. A real password in a committed example is published the moment the
# repository is, and it stays in the history after it is edited out.
# Local development environment. Copy to .env, which is gitignored:
#
#   make env
#
# The Makefile loads .env and exports it. The binary reads only the process environment, so
# nothing here changes how a deployment behaves.

# This consumer has its own database. That is the point rather than an inconvenience: a
# projection sharing a database with the authority could be updated by a join instead of by
# an event, and the property under test would no longer be a property of the event path.
REFERENCE_DATABASE_URL=postgres://postgres:CHANGEME@localhost:5432/foundation_reference_dev?sslmode=disable
REFERENCE_MIGRATION_DATABASE_URL=postgres://postgres:CHANGEME@localhost:5432/foundation_reference_dev?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:CHANGEME@localhost:5432/foundation_reference_dev?sslmode=disable

REFERENCE_LISTEN_ADDRESS=127.0.0.1:8096

# The OpenTelemetry Collector's OTLP/HTTP base URL. Unset, nothing is exported and startup says so.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Stable across restarts and replicas: inbox.Guard deduplicates per (event_id, consumer), so
# a name derived from a hostname would let a second replica re-apply what a first applied.
REFERENCE_CONSUMER_NAME=foundation-reference

# LOW_RISK's staleness budget, and its whole permission to answer from the projection: past
# this the operation is refused. Deliberately short in development so a stale projection is
# easy to observe by hand.
REFERENCE_MAX_PROJECTION_AGE=60s

# organization-control. PRIVILEGED and IRREVERSIBLE ask it directly instead of reading the
# projection. Leave it empty to see those two classes refuse for want of an authority.
REFERENCE_AUTHORITY_BASE_URL=http://127.0.0.1:8099
REFERENCE_AUTHORITY_TIMEOUT=2s

# organization-control's workload principal_id: the one caller POST /v1/deliveries admits
# (ADR-GLB-018 §5.4). Required. Deliveries come from organization-control's own process, which this
# repository no longer duplicates: run it with this consumer in ORGANIZATION_DELIVERY_TARGETS (its
# .env.example has the block). Its dev issuer names this principal_id unless
# ORGANIZATION_DEVISSUER_CLIENT_PRINCIPAL_ID says otherwise.
REFERENCE_DELIVERY_PRINCIPAL_ID=55555555-5555-4555-8555-55555555550b

# The Windows linker writes its scratch to TEMP rather than GOTMPDIR, so both are set.
# Left on C: they fill a drive that has no room, and the failure reads as a Go toolchain
# error about a temporary file rather than as a full disk.
GOTMPDIR=D:\Ansha\.gotmp
GOCACHE=D:\Ansha\.gocache
TMP=D:\Ansha\.gotmp
TEMP=D:\Ansha\.gotmp
GOPROXY=off
GOFLAGS=-mod=mod

# Token verification. Required: this deployable writes a projection that decides whether other
# people's operations proceed, so a build that can start without a verifier is a build that can
# be deployed with authentication off.
#
# In development the issuer is organization-control's dev issuer (make issuer over there). It
# must mint tokens whose audience is this service and whose scope claim carries
# foundation-reference.deliver (organization-control's workload token, from the issuer's client
# credentials grant) or foundation-reference.operate (for a caller).
# In production these are workload credentials, and per C9 of the principal review they should
# rest on an attestable mechanism rather than a long-lived shared secret.
REFERENCE_TOKEN_ISSUER=http://127.0.0.1:8098
REFERENCE_JWKS_URL=http://127.0.0.1:8098/certs
REFERENCE_TOKEN_AUDIENCE=foundation-reference
REFERENCE_TOKEN_MAX_SKEW=30s

# ---------------------------------------------------------------------------
# The system proof (make system-proof)
# ---------------------------------------------------------------------------
#
# Proof A across real processes. It builds two databases on the cluster below --
# organization_systemproof and reference_systemproof, both dropped and recreated each run -- so
# the connection must be a superuser's, and must never point at a cluster anyone depends on.
SYSTEMPROOF_ADMIN_DATABASE_URL=postgres://postgres:CHANGEME@localhost:5432/postgres?sslmode=disable

# organization-control's runtime login roles are CLUSTER roles, so the proof sets their passwords
# cluster-wide. Use the same values organization-control's own .env uses, or the proof will rewrite
# the credentials that repository's development setup depends on.
TEST_RUNTIME_PASSWORD=CHANGEME
TEST_PROVIDER_PASSWORD=CHANGEME
TEST_DISPATCH_PASSWORD=CHANGEME
TEST_RESOLUTION_PASSWORD=CHANGEME
TEST_CONSUMER_PASSWORD=CHANGEME

# Defaults to ../organization-control. It must be checked out at the commit in
# systemproof/organization-control.rev, with no local changes; the proof refuses anything else.
# SYSTEMPROOF_ORGANIZATION_CONTROL_SRC=..\organization-control
# SYSTEMPROOF_LOG_DIR=.systemproof\logs